Options -MultiViews
RewriteEngine On

# 1) If a browser requests a *.html URL directly, send a permanent redirect
#    to the clean (extension-less) URL. Keeps one canonical URL per deck.
#    Same pattern already proven working, live, in ../consultation/.htaccess
#    and at the site root — both a top-level page and a nested one deep.
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) Internally serve the matching .html file when the clean URL is
#    requested, without changing what's shown in the address bar.
#    Unlike a plain "REQUEST_FILENAME is not a directory" check, this also
#    wins over a same-named directory that has no index.html of its own —
#    a stray source folder like Decks/Marque/ must never again be able to
#    shadow Marque.html the way it did before.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^(.*)$ $1.html [NC,L]
