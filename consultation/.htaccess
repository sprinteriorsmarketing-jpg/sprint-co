Options -MultiViews
RewriteEngine On

# 1) If a browser requests the .html URL directly, send a permanent redirect
#    to the clean (extension-less) URL. Keeps one canonical URL per page.
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) Internally serve the matching .html file when the clean URL is requested,
#    without changing what's shown in the address bar.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]
