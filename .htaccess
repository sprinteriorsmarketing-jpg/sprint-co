Options -MultiViews
RewriteEngine On

# Retired blog subdomain: 301 its old URLs to the main site. Only applies if
# blog.sprint-co.com points at this folder (cPanel subdomain, root public_html).
RewriteCond %{HTTP_HOST} ^blog\.sprint-co\.com$ [NC]
RewriteRule ^projects/?$ https://www.sprint-co.com/projects [R=301,L]
RewriteCond %{HTTP_HOST} ^blog\.sprint-co\.com$ [NC]
RewriteRule ^category/coffee-shop-interior-design/?$ https://www.sprint-co.com/cafe-interior-design-projects [R=301,L]
RewriteCond %{HTTP_HOST} ^blog\.sprint-co\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://www.sprint-co.com/insights [R=301,L]

# Canonical host: send http:// and non-www requests to https://www.sprint-co.com
# in a single 301. Only matches the main domain, so subdomains served from
# folders inside public_html are untouched. Must stay above every other rule.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTP_HOST} ^(?:www\.)?sprint-co\.com$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^sprint-co\.com$ [NC]
RewriteRule ^ https://www.sprint-co.com%{REQUEST_URI} [R=301,L]

# Serve the branded error document while preserving the HTTP 404 status.
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# City pages: only the hub cities below are live. Each rule also matches the
# legacy root-level URL and the .html form. Must stay above rule 1 and the
# catch-all, or those rules fire first.
# Smaller cities folded into a nearby hub (301).
RewriteRule ^(?:(?:In|locations)/)?restaurant-interior-designer-(?:thane|navi-mumbai|lonavala|karjat)(?:\.html)?/?$ /In/restaurant-interior-designer-mumbai [NC,R=301,L]
RewriteRule ^(?:(?:In|locations)/)?restaurant-interior-designer-(?:noida|greater-noida|ghaziabad|faridabad|sonipat)(?:\.html)?/?$ /In/restaurant-interior-designer-delhi [NC,R=301,L]
RewriteRule ^(?:(?:In|locations)/)?restaurant-interior-designer-(?:anjuna|panaji|calangute|candolim|vagator|madgaon|benaulim|vasco-da-gama)(?:\.html)?/?$ /In/restaurant-interior-designer-goa [NC,R=301,L]
RewriteRule ^(?:(?:In|locations)/)?restaurant-interior-designer-(?:secunderabad)(?:\.html)?/?$ /In/restaurant-interior-designer-hyderabad [NC,R=301,L]
RewriteRule ^(?:(?:In|locations)/)?restaurant-interior-designer-(?:gandhinagar)(?:\.html)?/?$ /In/restaurant-interior-designer-ahmedabad [NC,R=301,L]
RewriteRule ^(?:(?:In|locations)/)?restaurant-interior-designer-(?:abu-dhabi)(?:\.html)?/?$ /locations/restaurant-interior-designer-dubai [NC,R=301,L]
RewriteRule ^(?:(?:In|locations)/)?restaurant-interior-designer-(?:pune)(?:\.html)?/?$ /cities [NC,R=301,L]
# Thin city pages retired for good (410 Gone).
RewriteRule ^(?:(?:In|locations)/)?restaurant-interior-designer-(?:abu-road|ajmer|alwar|amreli|amritsar|ankleshwar|aurangabad|bharatpur|bharuch|bhavnagar|bhopal|bhubaneswar|bikaner|bilaspur|bokaro|chikkamagaluru|chittorgarh|coimbatore|darjeeling|dehradun|dharamshala|ernakulam|gangtok|gujarat|guwahati|gwalior|hampi|haridwar|haryana|howrah|hubballi|igatpuri|jabalpur|jaisalmer|jalandhar|jalgaon|jammu|jamnagar|jamshedpur|jhansi)(?:\.html)?/?$ - [NC,G]
RewriteRule ^(?:(?:In|locations)/)?restaurant-interior-designer-(?:jodhpur|kanpur|kochi|kolhapur|kolkata|kota|kozhikode|ludhiana|madurai|manali|mangalore|mathura|meerut|mussoorie|mysuru|nagaon|nagpur|nainital|nashik|nellore|ooty|panipat|patiala|patna|pimpri-chinchwad|prayagraj|rajkot|rajpur|ranchi|ratnagiri|rohtak|sangamner|satara|shillong|shimla|shirdi|siliguri|solapur|srinagar|thiruvananthapuram)(?:\.html)?/?$ - [NC,G]
RewriteRule ^(?:(?:In|locations)/)?restaurant-interior-designer-(?:thrissur|tiruchirappalli|tirupati|udaipur|udupi|ujjain|vadodara|valsad|vapi|varanasi|vellore|vijayawada|visakhapatnam)(?:\.html)?/?$ - [NC,G]
RewriteRule ^(?:(?:In|locations)/)?restaurant-interior-designer-(?:auckland|austin|bahrain|baku|bali|bangkok|beijing|boston|brisbane|brussels|cape-town|cebu|colombo|davao|doha|dublin|galle|greece|guangzhou|hikkaduwa|jakarta|johannesburg|kandy|kuwait-city|london|malta|manila|melbourne|montreal|muscat|nairobi|new-jersey|new-york|paris|perth|phoenix|port-elizabeth|prague|rome|seoul|shanghai|shenzhen|singapore|sydney|tbilisi|tokyo|toronto|turkey|vancouver)(?:\.html)?/?$ - [NC,G]
# Legacy root-level URLs for the live hubs.
RewriteRule ^(restaurant-interior-designer-(?:dubai))(?:\.html)?$ /locations/$1 [R=301,L]
RewriteRule ^(restaurant-interior-designer-[a-z-]+?)(?:\.html)?$ /In/$1 [R=301,L]

# Wrong-case folder names (Linux paths are case-sensitive): /in/ -> /In/, /Locations/ -> /locations/
RewriteCond %{REQUEST_URI} !^/In/
RewriteRule ^in/(.*)$ /In/$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/locations/
RewriteRule ^locations/(.*)$ /locations/$1 [NC,R=301,L]

# Legacy WordPress URLs (Search Console 'Not found (404)' export, 2026-10-21) -> closest current page.
# Matches with or without the trailing slash, in one hop.
