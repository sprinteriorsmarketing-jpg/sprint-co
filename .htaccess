RewriteRule ^ /commercial-kitchen-equipment-complete-setup-for-f-b? [R=301,L]

# 301 redirect: old slug -> renamed slug
RewriteCond %{THE_REQUEST} \s/+how-to-design-a-cafe-interior/?[\s?] [NC]
RewriteRule ^ /how-to-design-a-cafe-interior-guide-for-first-time-owners? [R=301,L]

# 301 redirect: old slug -> renamed slug
